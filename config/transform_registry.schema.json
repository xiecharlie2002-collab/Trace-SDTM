{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["registry_version", "categories", "transforms"],
  "additionalProperties": false,
  "properties": {
    "registry_version": {"type": "string"},
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "stage_order"],
        "properties": {
          "description": {"type": "string"},
          "stage_order": {"type": "integer", "minimum": 1}
        }
      }
    },
    "transforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["transform_id", "title", "description", "category", "execution_stage", "model_selectable", "implementation_id", "provider", "source_contract", "target_contract", "parameter_schema", "preconditions", "not_allowed_when", "examples"],
        "additionalProperties": false,
        "properties": {
          "transform_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "category": {"type": "string"},
          "execution_stage": {"enum": ["source_preparation", "field_mapping", "record_expansion", "post_derivation", "no_output"]},
          "model_selectable": {"type": "boolean"},
          "implementation_id": {"type": "string"},
          "provider": {"type": "object", "required": ["name", "function"], "properties": {"name": {"type": "string"}, "function": {"type": "string"}}},
          "source_contract": {"type": "object", "required": ["minimum", "maximum", "minimum_datasets", "maximum_datasets"], "properties": {"minimum": {"type": "integer", "minimum": 0}, "maximum": {"type": "integer", "minimum": 0}, "minimum_datasets": {"type": "integer", "minimum": 0}, "maximum_datasets": {"type": "integer", "minimum": 0}, "types": {"type": "array", "items": {"type": "string"}}}},
          "target_contract": {"type": "object", "required": ["domains", "patterns", "output_mode"], "properties": {"domains": {"type": "array", "items": {"type": "string"}}, "patterns": {"type": "array", "items": {"type": "string"}}, "output_mode": {"enum": ["single", "multiple", "dataset", "records", "none"]}}},
          "parameter_schema": {"type": "object"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "not_allowed_when": {"type": "array", "items": {"type": "string"}},
          "examples": {"type": "array", "minItems": 1, "items": {"type": "object"}}
        }
      }
    }
  }
}
